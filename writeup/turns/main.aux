\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The three local facts in Lemma~\ref {lem:four}. Red arrows: the two moves of the cell. Dashed arrows: other moves of the same type. Left: a cell in column $0$ has only moves to the right. Middle: a cell in column $1$ with two \emph  {outward} moves (to column $0$ or column $3$) turns, because the horizontal steps $-1$ and $+2$ do not cancel. Right: a cell in column $3$ with no move back to columns $1,2$ has two moves to the right, so it turns.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:lemma}{{1}{3}{The three local facts in Lemma~\ref {lem:four}. Red arrows: the two moves of the cell. Dashed arrows: other moves of the same type. Left: a cell in column $0$ has only moves to the right. Middle: a cell in column $1$ with two \emph {outward} moves (to column $0$ or column $3$) turns, because the horizontal steps $-1$ and $+2$ do not cancel. Right: a cell in column $3$ with no move back to columns $1,2$ has two moves to the right, so it turns}{figure.1}{}}
